---
import Base from '../layouts/Base.astro';
import IssueView from '../components/IssueView.astro';
import T from '../components/T.astro';
import { getIssues } from '../kit/data';
const issue = getIssues()[0];
const sample = !!issue && issue.date === '2026-01-01';
---
<Base title={issue?.title} palette={issue?.palette} description={issue?.dek}>
  {issue ? <IssueView issue={issue} sample={sample} /> : <p class="empty"><T k="noIssue" /></p>}
</Base>
