---
import Base from '../layouts/Base.astro';
import IssueView from '../components/IssueView.astro';
import { getIssues } from '../kit/data';
export function getStaticPaths() {
  return getIssues().map((issue) => ({ params: { date: issue.date }, props: { issue } }));
}
const { issue } = Astro.props;
---
<Base title={issue.title} palette={issue.palette} description={issue.dek}>
  <IssueView issue={issue} sample={issue.date === '2026-01-01'} />
</Base>
