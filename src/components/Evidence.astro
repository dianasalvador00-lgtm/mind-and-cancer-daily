---
import T from './T.astro';
import Inline from './Inline.astro';
type E = { type: string; model?: string; n?: string; phase?: string; status?: string; limitation?: string; conflicts?: string };
// mode: 'all' badge, meta and notes; 'line' badge and meta; 'detail' meta and notes (no badge);
// 'notes' limitation and conflicts only
const { e, mode = 'all', hideLimitation = false } = Astro.props as { e: E; mode?: 'all' | 'line' | 'detail' | 'notes'; hideLimitation?: boolean };
const meta = [e.model, e.n, e.phase && `Phase ${e.phase}`, e.status].filter(Boolean) as string[];
const showBadge = mode === 'all' || mode === 'line';
const showMeta = mode !== 'notes' && meta.length > 0;
const showNotes = mode === 'all' || mode === 'notes' || mode === 'detail';
---
<div class="evidence">
  {(showBadge || showMeta) && (
    <p class="ev-line">
      {showBadge && <span class={`ev ev-${e.type}`}><T k={`ev_${e.type}`} /></span>}
      {showMeta && <span class="ev-meta">{meta.join(' · ')}</span>}
    </p>
  )}
  {showNotes && e.limitation && !hideLimitation && <p class="ev-note"><strong><T k="limitations" />.</strong> <Inline text={e.limitation} /></p>}
  {showNotes && e.conflicts && <p class="ev-note"><strong>Funding or conflicts.</strong> <Inline text={e.conflicts} /></p>}
</div>
