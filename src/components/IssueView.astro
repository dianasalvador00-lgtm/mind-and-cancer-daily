---
import T from './T.astro';
import Inline from './Inline.astro';
import Sources from './Sources.astro';
import Evidence from './Evidence.astro';
import Feedback from './Feedback.astro';
import Diagram from './Diagram.astro';
import Figure from './Figure.astro';
import { formatDate, type IssueT } from '../kit/data';
const { issue, sample = false } = Astro.props as { issue: IssueT; sample?: boolean };
const d = issue.date;
const nav = [
  ['top', 'top'], ['bench', 'bench'], ['method', 'method'], ['learn', 'learn'],
  ['trials', 'trials'], ['chatter', 'chatter'], ['curiosity', 'curiosity'], ['jobs', 'jobs'],
] as const;
const glossary = (terms?: { term: string; def: string }[]) => terms ?? [];
---
<article class="issue">
  <header class="issue-head">
    <p class="kicker"><T k="issue" /> {issue.number} <span class="dot">&middot;</span> <time data-date={d} datetime={d}>{formatDate(d)}</time></p>
    <h1><Inline text={issue.title} /></h1>
    <p class="dek"><Inline text={issue.dek} /></p>
    {sample && <p class="sample-note"><T k="sample" /></p>}
  </header>

  <nav class="sections" aria-label="Sections">
    {nav.map(([id, key]) => <a href={`#${id}`}><T k={key} /></a>)}
  </nav>

  <section class="tldr" aria-labelledby="tldr-h">
    <h2 id="tldr-h"><T k="todayInShort" /></h2>
    <ul>
      {issue.tldr.map((t) => (
        <li><span class="area" data-area={t.area}><T k={`area_${t.area}`} /></span> <Inline text={t.text} /></li>
      ))}
    </ul>
  </section>

  <section id="top" class="block">
    <h2><T k="top" /></h2>
    {issue.top.map((s) => (
      <article class="item" id={s.id}>
        <p class="kicker"><span class="area" data-area={s.area}><T k={`area_${s.area}`} /></span></p>
        <h3><Inline text={s.title} /></h3>
        <p class="gist"><Inline text={s.gist} terms={s.terms} /></p>
        <Evidence e={s.evidence} />
        <p class="why"><strong><T k="why" />.</strong> <Inline text={s.why} terms={s.terms} /></p>
        {s.didNotShow && <p class="ev-note"><strong><T k="didNotShow" />.</strong> <Inline text={s.didNotShow} /></p>}
        {s.image && <Figure img={s.image} />}
        {(s.details || glossary(s.terms).length > 0) && (
          <details>
            <summary><T k="details" /></summary>
            {s.details?.map((p) => <p><Inline text={p} terms={s.terms} /></p>)}
            {glossary(s.terms).length > 0 && (
              <dl class="glossary">{glossary(s.terms).map((t) => <><dt>{t.term}</dt><dd>{t.def}</dd></>)}</dl>
            )}
          </details>
        )}
        <Sources list={s.sources} />
        <Feedback id={s.id} section="top" title={s.title} area={s.area} date={d} forYou={s.forYou} />
      </article>
    ))}
  </section>

  <section id="bench" class="block">
    <h2><T k="bench" /></h2>
    {issue.bench.map((b) => (
      <article class="item bench" id={b.id}>
        <p class="kicker"><span class="area" data-area={b.area}><T k={`area_${b.area}`} /></span> <span class="dot">&middot;</span> {b.venue}, <time datetime={b.published}>{formatDate(b.published)}</time></p>
        <h3><Inline text={b.headline} /></h3>
        <p class="paper-title"><Inline text={b.title} /> <span class="authors">{b.authors}</span></p>
        <Evidence e={b.evidence} hideLimitation />
        <dl class="bench-grid">
          <dt><T k="question" /></dt><dd><Inline text={b.question} terms={b.terms} /></dd>
          <dt><T k="approach" /></dt><dd><Inline text={b.approach} terms={b.terms} /></dd>
          <dt><T k="model" /></dt><dd><Inline text={b.model} terms={b.terms} /></dd>
          <dt><T k="result" /></dt><dd class="result"><Inline text={b.result} terms={b.terms} /></dd>
          <dt><T k="limitations" /></dt><dd><Inline text={b.limitations} terms={b.terms} /></dd>
          <dt><T k="meaning" /></dt><dd><Inline text={b.meaning} terms={b.terms} /></dd>
        </dl>
        {b.image && <Figure img={b.image} />}
        {b.diagram && <Diagram d={b.diagram} />}
        <Sources list={b.sources} />
        <Feedback id={b.id} section="bench" title={b.title} area={b.area} date={d} forYou={b.forYou} />
      </article>
    ))}
  </section>

  <section id="method" class="block">
    <h2><T k="method" /></h2>
    <article class="item" id={issue.method.id}>
      <p class="kicker"><span class="area" data-area={issue.method.field}><T k={`area_${issue.method.field}`} /></span></p>
      <h3><Inline text={issue.method.title} /></h3>
      <p class="gist"><Inline text={issue.method.gist} terms={issue.method.terms} /></p>
      <p><strong><T k="useWhen" />.</strong> <Inline text={issue.method.useWhen} /></p>
      <h4><T k="steps" /></h4>
      <ol class="steps">
        {issue.method.steps.map((s) => <li><strong>{s.title}.</strong> <Inline text={s.text} terms={issue.method.terms} /></li>)}
      </ol>
      {issue.method.pitfalls && (
        <>
          <h4><T k="pitfalls" /></h4>
          <ul>{issue.method.pitfalls.map((p) => <li><Inline text={p} /></li>)}</ul>
        </>
      )}
      <p class="safety"><strong><T k="safety" />.</strong> <Inline text={issue.method.safety} /></p>
      <Sources list={[issue.method.source]} label="source" />
      <Feedback id={issue.method.id} section="method" title={issue.method.title} area={issue.method.field} date={d} forYou={issue.method.forYou} />
    </article>
  </section>

  <section id="learn" class="block">
    <h2><T k="learn" /></h2>
    <article class="item learn">
      <h3><Inline text={issue.learn.question} /></h3>
      <p class="gist"><Inline text={issue.learn.answer} terms={issue.learn.terms} /></p>
      {issue.learn.analogy && <p class="analogy"><strong><T k="analogy" />:</strong> <Inline text={issue.learn.analogy} /></p>}
      {issue.learn.diagram && <Diagram d={issue.learn.diagram} />}
      {issue.learn.image && <Figure img={issue.learn.image} />}
      {issue.learn.body.map((p) => <p><Inline text={p} terms={issue.learn.terms} /></p>)}
      {issue.learn.seenIn && issue.learn.seenIn.length > 0 && (
        <p class="seen-in"><T k="seenIn" />: {issue.learn.seenIn.map((id, i) => <>{i > 0 && ', '}<a href={`#${id}`}>{id}</a></>)}</p>
      )}
      <Sources list={issue.learn.sources} />
      <Feedback id="learn" section="learn" title={issue.learn.question} date={d} />
    </article>
  </section>

  <section id="trials" class="block">
    <h2><T k="trials" /></h2>
    {issue.trials.trials.length > 0 && <h3 class="sub"><T k="trialsOnly" /></h3>}
    {issue.trials.trials.map((t) => (
      <article class="item compact" id={t.id}>
        <p class="kicker"><span class="area" data-area={t.area}><T k={`area_${t.area}`} /></span> <span class="dot">&middot;</span> <span class={`chg chg-${t.change}`}><T k={`change_${t.change}`} /></span></p>
        <h4><Inline text={t.title} /></h4>
        <p><Inline text={t.what} /></p>
        <p class="facts"><span><T k="phase" /> {t.phase}</span> <span><T k="status" />: {t.status}</span> <span>{t.nct}</span> <span><T k="sponsor" />: {t.sponsor}</span></p>
        <p class="facts"><span>{t.who}</span></p>
        <Sources list={t.sources} />
        <Feedback id={t.id} section="trials" title={t.title} area={t.area} date={d} />
      </article>
    ))}
    {issue.trials.funding.length > 0 && <h3 class="sub"><T k="funding" /></h3>}
    {issue.trials.funding.map((c) => (
      <article class="item compact" id={c.id}>
        <p class="kicker"><span class="area" data-area={c.area}><T k={`area_${c.area}`} /></span></p>
        <h4><Inline text={c.title} /></h4>
        <p class="facts">
          <span><T k="funder" />: {c.funder}</span>
          {c.deadline && <span><T k="deadline" />: <time data-date={c.deadline} datetime={c.deadline}>{formatDate(c.deadline)}</time></span>}
          {c.amount && <span><T k="amount" />: {c.amount}</span>}
        </p>
        <p><strong><T k="eligibility" />.</strong> <Inline text={c.eligibility} /></p>
        <Sources list={c.sources} />
        <Feedback id={c.id} section="funding" title={c.title} area={c.area} date={d} />
      </article>
    ))}
  </section>

  <section id="chatter" class="block">
    <h2><T k="chatter" /></h2>
    {issue.chatter.map((c) => (
      <article class="item compact" id={c.id}>
        <p class="kicker"><span class="area" data-area={c.area}><T k={`area_${c.area}`} /></span> <span class="dot">&middot;</span> <T k={`kind_${c.kind}`} /> <span class="dot">&middot;</span> {c.where}</p>
        <h4><Inline text={c.title} /></h4>
        <p><Inline text={c.gist} /></p>
        <p class="signal">{c.signal}</p>
        <Sources list={c.sources} />
        <Feedback id={c.id} section="chatter" title={c.title} area={c.area} date={d} />
      </article>
    ))}
  </section>

  <section id="curiosity" class="block">
    <h2><T k="curiosity" /></h2>
    <article class="item" id={issue.curiosity.id}>
      <h3><Inline text={issue.curiosity.title} /></h3>
      <p class="gist"><Inline text={issue.curiosity.gist} /></p>
      <Evidence e={issue.curiosity.evidence} />
      {issue.curiosity.image && <Figure img={issue.curiosity.image} />}
      {issue.curiosity.body.map((p) => <p><Inline text={p} /></p>)}
      <Sources list={issue.curiosity.sources} />
      <Feedback id={issue.curiosity.id} section="curiosity" title={issue.curiosity.title} area={issue.curiosity.area} date={d} />
    </article>
  </section>

  <section id="jobs" class="block">
    <h2><T k="jobs" /></h2>
    {issue.jobs.length === 0 && <p class="muted">No matching openings today.</p>}
    {issue.jobs.map((j) => (
      <article class="item compact" id={j.id}>
        <p class="kicker"><T k={`level_${j.level}`} /> <span class="dot">&middot;</span> {j.location}</p>
        <h4><Inline text={j.title} /></h4>
        <p class="facts">
          <span>{j.employer}</span>
          {j.salary ? <span><T k="salary" />: {j.salary}</span> : <span class="muted"><T k="salaryNotStated" /></span>}
          {j.deadline && <span><T k="deadline" />: <time data-date={j.deadline} datetime={j.deadline}>{formatDate(j.deadline)}</time></span>}
        </p>
        <p><strong><T k="fit" />.</strong> <Inline text={j.fit} /></p>
        <Sources list={j.sources} label="source" />
        <Feedback id={j.id} section="jobs" title={j.title} date={d} />
      </article>
    ))}
  </section>

  {issue.note && <p class="colophon"><Inline text={issue.note} /></p>}
</article>
