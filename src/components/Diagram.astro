---
// A clear diagram drawn from data, in HTML and CSS so it stays legible and wraps on a phone.
// flow, layers, hub, cycle, timeline (dated steps) and compare (2 to 4 things side by side).
// The figure measures its own width (a size container) and a flow or cycle stacks vertically when
// its nodes would get narrower than a readable minimum, so labels never break inside a word.
import Inline from './Inline.astro';
type N = { label: string; note?: string; key?: boolean };
const { d } = Astro.props as { d: { layout: 'flow' | 'layers' | 'hub' | 'cycle' | 'timeline' | 'compare'; nodes: N[]; links?: string[]; caption: string } };
const arrows = d.layout === 'flow' || d.layout === 'cycle';
---
<figure class={`diagram diagram-${d.layout}`} data-n={d.nodes.length} role="group" aria-label={d.caption}>
  {d.layout === 'timeline' ? (
    <ol class="timeline">
      {d.nodes.map((n) => (
        <li class={n.key ? 'tl-item key' : 'tl-item'}>
          <span class="tl-dot" aria-hidden="true"></span>
          <span class="tl-when">{n.label}</span>
          {n.note && <span class="tl-what">{n.note}</span>}
        </li>
      ))}
    </ol>
  ) : d.layout === 'compare' ? (
    <div class="compare" style={`--cols:${d.nodes.length}`}>
      {d.nodes.map((n) => (
        <div class={n.key ? 'cmp key' : 'cmp'}>
          <span class="cmp-value">{n.label}</span>
          {n.note && <span class="cmp-note">{n.note}</span>}
        </div>
      ))}
    </div>
  ) : (
    <ol class="nodes">
      {d.nodes.map((n, i) => (
        <>
          <li class={n.key ? 'node key' : 'node'}>
            <span class="node-label">{n.label}</span>
            {n.note && <span class="node-note">{n.note}</span>}
          </li>
          {arrows && (i < d.nodes.length - 1 || d.layout === 'cycle') && (
            <li class="arrow" aria-hidden="true">
              <span class="arrow-glyph">{d.layout === 'cycle' && i === d.nodes.length - 1 ? '↺' : '→'}</span>
              {d.links?.[i] && <span class="arrow-label">{d.links[i]}</span>}
            </li>
          )}
        </>
      ))}
    </ol>
  )}
  <figcaption><Inline text={d.caption} /></figcaption>
</figure>
