---
import T from './T.astro';
const { list, label = 'sources' } = Astro.props as { list: { label: string; url: string; doi?: string }[]; label?: string };
---
<p class="sources">
  <span class="sources-label"><T k={label} /></span>
  {list.map((s, i) => (
    <>
      {i > 0 && <span class="sep">, </span>}
      <a href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a>{s.doi && <span class="doi"> (DOI {s.doi})</span>}
    </>
  ))}
</p>
