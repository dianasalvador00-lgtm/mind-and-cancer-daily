  "medicalAdvicePatterns": [
    "\\byou should (take|stop|start|use|try|avoid)\\b",
    "\\bpatients should\\b",
    "\\bask your (doctor|physician|gp)\\b",
    "\\bconsult your\\b",
    "\\bwe recommend (that )?(patients|you)\\b"
  ],
  "privatePatterns": [
    "\\bDiana Salvador\\b",
    "\\bmy (lab|thesis|phd|project|group|institution|university|supervisor|unpublished)\\b",
    "\\bour (lab|group|institution|unpublished)\\b",
    "\\bunpublished (data|results|work|findings) (from|of) (my|our)\\b"
